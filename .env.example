# Environment variables template for Commerce Integration Hub
# Copy this file to .env.local (or set environment variables directly) to override defaults.
#
# DO NOT COMMIT REAL PASSWORDS OR PRODUCTION SECRETS TO GIT.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_to_a_random_secret_in_production
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> PostgreSQL Configuration ###
POSTGRES_DB=commerce_db
POSTGRES_USER=commerce_user
POSTGRES_PASSWORD=change_this_password_for_local_env
###< PostgreSQL Configuration ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> faustddd/symfony-1c-import ###
CML_ENDPOINT=/cml/1c_exchange
CML_USER=admin
CML_PASSWORD=change_this_cml_password
###< faustddd/symfony-1c-import ###
